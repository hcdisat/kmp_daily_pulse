CREATE TABLE Article (
    id INTEGER PRIMARY KEY NOT NULL,
    author TEXT,
    content TEXT,
    description TEXT,
    published_at TEXT NOT NULL,
    title TEXT NOT NULL,
    url TEXT NOT NULL,
    url_image TEXT
);

selectAll:
SELECT Article.* FROM Article ORDER BY published_at DESC LIMIT 60;

selectById:
SELECT Article.* FROM Article WHERE id = ? LIMIT 1;

deleteAll:
DELETE FROM Article;

deleteById:
DELETE FROM Article WHERE id = ? LIMIT 1;

insert:
INSERT INTO Article(author, content, description, published_at, title, url, url_image)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertFull:
INSERT INTO Article(author, content, description, published_at, title, url, url_image)
VALUES ?;

CREATE TABLE SourceSetting (
    id INTEGER PRIMARY KEY NOT NULL,
    category TEXT NOT NULL,
    sourceId TEXT,
    sourceName TEXT
);

INSERT INTO SourceSetting(category) VALUES('business');

updateCategory:
UPDATE SourceSetting SET category = ? WHERE id = 1;

updateSource:
UPDATE SourceSetting SET sourceId = ?, sourceName = ? WHERE id = 1;

selectSourceConfig:
SELECT SourceSetting.* FROM SourceSetting WHERE id = 1 LIMIT 1;